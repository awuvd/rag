# RAG 项目 · 忽略项

# 虚拟环境（体积大，不进版本管理）
.venv/
venv/
env/
ENV/

# PyCharm / 编辑器
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Obsidian（本机笔记软件配置，不进仓库）
.obsidian/
*.base

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# 数据文件（都是"派生产物"，跑脚本就能重新生成，不进版本管理）
#   book.txt                    ← D3 从 PDF 提取
#   chapters.json / chunks.json ← D4 切分产生
data/*.txt
data/*.pdf
data/*.json

# 向量库持久化目录（运行时生成，很大）
chroma_db/
*.sqlite3
*.db

# 模型文件
models/
*.bin
*.safetensors

# 环境变量
.env

# 日志
*.log

# ---- 个人本地笔记（仅本地查看，不 push 到仓库）----
函数速查手册.md
